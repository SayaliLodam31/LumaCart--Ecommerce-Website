# Django Configuration
DJANGO_SECRET_KEY=lumacart-secret-key-change-me-in-production-e-commerce-2026-fashion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration: PostgreSQL (Supabase / Production)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_database_password
DB_HOST=db.your_supabase_project_ref.supabase.co
DB_PORT=5432


# Razorpay Payment Gateway (Test credentials by default)
RAZORPAY_KEY_ID=rzp_test_lumacart2026
RAZORPAY_KEY_SECRET=secret_test_lumacart_key_demo99

# Celery & Channels Redis Broker
REDIS_URL=redis://localhost:6379/0

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=support@lumacart.com
EMAIL_HOST_PASSWORD=change_this_email_app_password
DEFAULT_FROM_EMAIL="LumaCart Fashion <noreply@lumacart.com>"

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
